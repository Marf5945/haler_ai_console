root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
end_of_line = lf

[*.md]
end_of_line = lf

[*.txt]
end_of_line = lf

[*.json]
end_of_line = lf

[*.js]
end_of_line = lf

[*.jsx]
end_of_line = lf

[*.ts]
end_of_line = lf

[*.tsx]
end_of_line = lf

[*.css]
end_of_line = lf

[*.html]
end_of_line = lf

[*.xml]
end_of_line = lf

[*.yml]
end_of_line = lf

[*.yaml]
end_of_line = lf

[*.toml]
end_of_line = lf

[*.svg]
end_of_line = lf

[*.sh]
end_of_line = lf

[*.command]
end_of_line = lf

[*.py]
end_of_line = lf

[*.cjs]
end_of_line = lf

[*.mjs]
end_of_line = lf

[*.bat]
end_of_line = crlf

[*.cmd]
end_of_line = crlf

[*.ps1]
end_of_line = crlf
